# Скопируйте в .env и заполните. .env не коммитится.
# Для публичного развёртывания установите production: шаблонные секреты будут отклонены.
# Compose подставляет в каждый сервис только нужные переменные (не весь файл).
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO / S3 ---
# Пароль без символов @ : / — он подставляется в URL для mc.
# Образ MinIO (содержит и сервер, и клиент mc). Публичные образы MinIO
# в Docker Hub больше не обновляются — при необходимости укажите свой реестр.
# MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=products

# --- Публичные адреса ---
# Локально — http://localhost, в Telegram — HTTPS-адрес туннеля или сервера.
PUBLIC_BASE_URL=http://localhost
PUBLIC_MEDIA_URL=http://localhost/media/

# --- Telegram-бот ---
BOT_TOKEN=123456:replace-with-botfather-token
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token: A-Z, a-z, 0-9, _ и -
WEBHOOK_SECRET=change-me-webhook-secret
# Telegram user id админов через запятую
ADMIN_IDS=123456789

# --- Межсервисное взаимодействие ---
# Токен заголовка X-Service-Token для POST /internal/products
SERVICE_TOKEN=change-me-service-token
# Адрес backend внутри docker-сети (для бота и SSR фронтенда)
BACKEND_INTERNAL_URL=http://backend:8000
